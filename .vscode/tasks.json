{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/src/SimpleReplay/SimpleReplay.csproj",
        "-c", "Debug"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": { "reveal": "silent" },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "publish (release)",
      "command": "dotnet",
      "type": "process",
      "args": [
        "publish",
        "${workspaceFolder}/src/SimpleReplay/SimpleReplay.csproj",
        "-c", "Release",
        "-r", "win-x64",
        "--no-self-contained",
        "-p:PublishSingleFile=true",
        "-o", "${workspaceFolder}/publish"
      ],
      "group": "build",
      "presentation": { "reveal": "always" },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "pack (velopack)",
      "type": "shell",
      "command": "vpk pack --packId SimpleReplay --packVersion 1.0.0-dev --packDir publish --mainExe SimpleReplay.exe --packTitle 'Simple Replay' --framework net8.0-x64-desktop --outputDir releases",
      "group": "build",
      "dependsOn": "publish (release)",
      "presentation": { "reveal": "always" },
      "problemMatcher": []
    }
  ]
}
